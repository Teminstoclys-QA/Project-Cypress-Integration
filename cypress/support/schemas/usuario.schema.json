{
  "$id": "usuario",
  "type": "object",
  "required": ["nome", "email", "password", "administrador", "_id"],
  "additionalProperties": false,
  "properties": {
    "nome": { "type": "string" },
    "email": { "type": "string" },
    "password": { "type": "string" },
    "administrador": { "type": "string", "enum": ["true", "false"] },
    "_id": { "type": "string", "minLength": 1 }
  }
}
